/* ─────────────────────────────────────────────────────────────────────────
 * Кнопка «‹ Назад» — единый вид на всех экранах приложения.
 *
 * Ставится НА САМУ КНОПКУ (см. setupArchiveBackButton в ui/ScreenTheme.h), а
 * не на экран. Так вид одинаков и на экранах, переведённых на общую тему, и
 * на тех, что ещё живут со своим оформлением («Карта», «Пуск измерений»):
 * стилшит виджета применяется независимо от того, что задано у предков.
 *
 * Рамка прозрачная, а не отсутствующая: при наведении она лишь меняет цвет,
 * поэтому подпись не смещается на пиксель, как это было бы при появлении
 * рамки из ниоткуда.
 *
 * Подпись центрируется (никакого text-align: left): прямоугольник подсветки
 * — это вся кнопка, и текст должен стоять в его середине.
 * ───────────────────────────────────────────────────────────────────────── */
QPushButton[nav="true"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 10px;
    color: #0F6B4F;
    font-size: 13px;
    font-weight: 600;
}
QPushButton[nav="true"]:hover {
    background: #E4F1EC;
    border-color: #CBE3D9;
    color: #0F6B4F;
}
QPushButton[nav="true"]:pressed {
    background: #D8ECE3;
    border-color: #B7D8C9;
    color: #0B5A41;
}
QPushButton[nav="true"]:disabled {
    color: #B7BEBB;
}
