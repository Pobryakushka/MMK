<RCC>
    <qresource prefix="/">
        <file>qml/Main.qml</file>
        <file>qml/MapComponent.qml</file>
        <file>qml/MarkerStation.qml</file>
        <file>qml/ToolTip.qml</file>
        <file>qml/ZoneRectangle.qml</file>
        <file>dat/images/map/coldHalfYearMap.png</file>
        <file>dat/images/map/warmHalfYearMap.png</file>
        <file>dat/images/marker.png</file>
        <file>icons/clock_manual_time.svg</file>
        <file>icons/clock_manual_time_pressed.svg</file>
        <file>icons/checkmark_white.svg</file>
        <file>icons/chevron_down.svg</file>
        <!-- Файлы оформления переехали в src/ui/theme/, но их путь ВНУТРИ
             ресурсов намеренно оставлен прежним (":/ui/...") через alias:
             так ни одна строка C++ с QFile(":/ui/table-theme.qss") не
             требует правки, и перенос остаётся чисто структурным. -->
        <file alias="ui/archive-style.qss">src/ui/theme/archive-style.qss</file>
        <file alias="ui/table-theme.qss">src/ui/theme/table-theme.qss</file>
        <file alias="ui/screen-theme.qss">src/ui/theme/screen-theme.qss</file>
        <file alias="ui/back-button.qss">src/ui/theme/back-button.qss</file>
    </qresource>
</RCC>
